  "pressure": {
   "items": [
    {
     "id": "p1",
     "type": "image",
     "x": 6,
     "y": 0,
     "w": 6,
     "h": 10,
     "caption": "Image",
     "src": "/uploads/20261009-md1d1txo.jpg",
     "variants": {
